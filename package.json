{
  "name": "red-tetris",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#game/*": {
      "types": "./game/*.ts",
      "development": "./game/*.ts",
      "default": "./dist/game/*.js"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm run --parallel \"/^dev:(client|server)$/\"",
    "build": "tsc --noEmit -p config/tsconfig.json && tsc --noEmit -p client/tsconfig.json && pnpm build:server && pnpm build:client",
    "start": "node dist/server/src/main.js",
    "test": "vitest run --config config/vitest.config.ts",
    "test:coverage": "vitest run --config config/vitest.config.ts --coverage",
    "test:e2e": "playwright test --config config/playwright.config.ts",
    "dev:server": "tsx watch --conditions=development server/src/main.ts --api-only",
    "dev:client": "vite client",
    "build:server": "tsc -p config/tsconfig.server.json",
    "build:client": "vite build client"
  },
  "devDependencies": {
    "@heroui/react": "^3.2.8",
    "@heroui/styles": "^3.2.8",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.0.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.0.0",
    "socket.io-client": "^4.8.4",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@12.22.0",
  "dependencies": {
    "express": "^5.3.0",
    "socket.io": "^4.8.4"
  }
}
