{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": [
      "node",
      "vite/client"
    ]
  },
  "include": [
    "*.config.ts",
    "../tests",
    "../server",
    "../game"
  ],
  "exclude": [
    "../node_modules",
    "../**/dist"
  ]
}
